{
    "name": "atldays/laravel-sculptor",
    "description": "This package provides a convenient interface for building complex database queries using Eloquent ORM in Laravel.",
    "keywords": [
        "sql",
        "database",
        "eloquent",
        "model",
        "repository",
        "builder",
        "laravel",
        "atldays"
    ],
    "minimum-stability": "stable",
    "license": "MIT",
    "homepage": "https://github.com/atldays/laravel-sculptor",
    "type": "library",
    "authors": [
        {
            "name": "Anjey Tsibylskij",
            "homepage": "https://github.com/atldays",
            "role": "Developer"
        }
    ],
    "autoload": {
        "psr-4": {
            "Atldays\\Sculptor\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Atldays\\Sculptor\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Atldays\\Sculptor\\SculptorServiceProvider"
            ]
        }
    },
    "require": {
        "php": "^8.2",
        "atldays/laravel-eloquent-filters": "^2.1",
        "atldays/laravel-eloquent-query-cache": "^2.2.0",
        "illuminate/cache": "^12.72|^13.42",
        "illuminate/contracts": "^12.72|^13.42",
        "illuminate/database": "^12.72|^13.42",
        "illuminate/pagination": "^12.72|^13.42",
        "illuminate/support": "^12.72|^13.42",
        "spatie/laravel-package-tools": "^1.93.3",
        "webmozart/assert": "^2.5"
    },
    "require-dev": {
        "laravel/pint": "^1.29.3",
        "mockery/mockery": "^1.6.15",
        "orchestra/testbench": "^11.3",
        "phpstan/phpstan": "^2.3.6",
        "phpunit/phpunit": "^13.4.7",
        "slevomat/coding-standard": "^8.31.3"
    },
    "scripts": {
        "analyse": "vendor/bin/phpstan analyse --memory-limit=1G",
        "format": [
            "vendor/bin/pint",
            "vendor/bin/phpcbf"
        ],
        "format:test": [
            "vendor/bin/pint --test",
            "vendor/bin/phpcs"
        ],
        "test": "vendor/bin/phpunit --no-coverage"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "sort-packages": true
    },
    "suggest": {
        "barryvdh/laravel-debugbar": "For debugging"
    },
    "prefer-stable": true
}
