{
    "preset": "laravel",
    "rules": {
        "cast_spaces": {
            "space": "none"
        },
        "concat_space": {
            "spacing": "one"
        },
        "group_import": true,
        "new_with_parentheses": {
            "anonymous_class": true,
            "named_class": false
        },
        "not_operator_with_successor_space": false,
        "phpdoc_align": {
            "align": "left",
            "spacing": 1
        },
        "single_import_per_statement": false,
        "unary_operator_spaces": true
    }
}
